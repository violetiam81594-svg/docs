def sanitize_input(value: str) -> str:
    """Sanitize user-provided input for safe use."""
    # Remove null bytes
    value = value.replace('\0', '')
    
    # Escape shell metacharacters
    dangerous = [';', '$(', '`', '|', '&', '\n', '\r', '\\', "'"]
    for char in dangerous:
        value = value.replace(char, '')
    
    # Limit length
    return value[:4096]
