### Device Detail Extraction

When `extract_device_detail: true`, the hook scans file paths and node names for device metadata.

```python
def extract_device_tokens(paths: list[str]) -> dict[str, set[str]]:
    """Extract device/file metadata from paths and node names.
    
    Returns:
        Dictionary mapping category to extracted tokens
        
    Example:
        ['/dev/sda1', 'node_data_controller', './config.yml']
        → {
            'devices': {'sda', 'sda1'},
            'controllers': {'data', 'controller'},
            'configs': {'config'}
          }
    """
    import re
    
    categories: dict[str, set[str]] = {
        'devices': set(),
        'controllers': set(),
        'configs': set(),
        'nodes': set(),
        'files': set(),
    }
    
    for path in paths:
        # Strip leading slashes and file extensions
        normalized = re.sub(r'^[/\\]+', '', path)
        normalized = re.sub(r'\.[a-zA-Z0-9]+$', '', normalized)
        
        # Tokenize
        tokens = set(re.split(r'[/\\_.-]+', normalized))
        tokens = {t for t in tokens if len(t) >= 2 and not t.isdigit()}
        
        # Categorize by prefix
        for token in tokens:
            token_lower = token.lower()
            if token_lower.startswith('dev'):
                categories['devices'].add(token)
            elif token_lower.endswith('controller') or 'ctrl' in token_lower:
                categories['controllers'].add(token)
            elif 'config' in token_lower:
                categories['configs'].add(token)
            elif token_lower.startswith('node'):
                categories['nodes'].add(token)
            else:
                categories['files'].add(token)
    
    return {k: v for k, v in categories.items() if v}
