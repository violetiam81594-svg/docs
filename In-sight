1	Validation error (blocking)
2	Warning only (continue execution)
Ambiguity Document Reviewer
Purpose
The ambiguity reviewer detects statements that are unclear, vague, or prone to misinterpretation. Common patterns include:

Pattern	Example	Recommended Replacement
Passive voice with missing agent	"The file was updated"	"The file was updated by @username on 2026-10-29"
Unspecified quantities	"Several contributors"	"Five contributors (list names)"
Vague time references	"Recently", "Soon"	"On 2026-10-15", "Within 5 business days"
Unsupported absolutes	"Always", "Never", "Everyone"	Add conditions or exceptions
Missing references	"See the documentation"	"See /docs/configuration.md#section"
Ambiguous pronouns	"It can be found there"	"The configuration file can be found at /etc/app/config.yaml"
Modal confusion	"May be required"	"Is required" or "May be omitted"
Detection Algorithm
#!/usr/bin/env python3
"""
Ambiguity detector for documentation review.

Detects passive voice, vague quantifiers, unspecified references,
and unsupported absolutes.
"""

from __future__ import annotations

import re
from dataclasses import dataclass
from pathlib import Path
from typing import Generator


@dataclass
class AmbiguityFinding:
    """Single ambiguity detection."""
    file_path: str
    line_number: int
    column_start: int
    column_end: int
    snippet: str
    category: str
    suggestion: str
    severity: str  # "info", "warning", "error"


# Passive voice patterns (English)
PASSIVE_VOICE_PATTERNS = [
    re.compile(r"\bw(as|ere)\s+\w+ed\b", re.IGNORECASE),
    re.compile(r"\bb(eing|one)\s+the\s+result\b", re.IGNORECASE),
]

# Vague quantifiers
VAGUE_QUANTIFIERS = re.compile(r"\b(several|many|some|a few|most|a number of)\b", re.IGNORECASE)

# Unspecific time references
VAGUE_TIME = re.compile(r"\b(recently|soon|later|eventually|shortly)\b", re.IGNORECASE)

# Unsupported absolutes
ABSOLUTES = re.compile(r"\b(always|never|everyone|everybody|nothing|nobody|completely|totally)\b", re.IGNORECASE)

# Vague references
VAGUE_REFERENCE = re.compile(r"\b(the\s+(?:above|below|following)|there|here)\b", re.IGNORECASE)

# Modal ambiguity
MODAL_AMBIGUITY = re.compile(r"\b(may\s+(?:be\s+)?required|could\s+be|might\s+be)\b", re.IGNORECASE)


def detect_passive_voice(text: str) -> list[AmbiguityFinding]:
    """Detect passive voice constructions."""
    findings = []
    for i, line in enumerate(text.splitlines(), start=1):
        for pattern in PASSIVE_VOICE_PATTERNS:
            for match in pattern.finditer(line):
                findings.append(AmbiguityFinding(
                    file_path="<stdin>",
                    line_number=i,
                    column_start=match.start(),
                    column_end=match.end(),
                    snippet=match.group(),
                    category="passive-voice",
                    suggestion="Consider active voice: 'X did Y' instead of 'Y was done by X'",
                    severity="info"
                ))
    return findings


def detect_vague_quantifiers(text: str) -> list[AmbiguityFinding]:
    """Detect vague quantifiers that should be replaced with specifics."""
    findings = []
    for i, line in enumerate(text.splitlines(), start=1):
        for match in VAGUE_QUANTIFIERS.finditer(line):
            findings.append(AmbiguityFinding(
                file_path="<stdin>",
                line_number=i,
                column_start=match.start(),
                column_end=match.end(),
                snippet=match.group(),
                category="vague-quantifier",
                suggestion="Specify exact numbers or percentages where possible",
                severity="warning"
            ))
    return findings


def detect_vague_time(text: str) -> list[AmbiguityFinding]:
    """Detect unspecific time references."""
    findings = []
    for i, line in enumerate(text.splitlines(), start=1):
        for match in VAGUE_TIME.finditer(line):
            findings.append(AmbiguityFinding(
                file_path="<stdin>",
                line_number=i,
                column_start=match.start(),
                column_end=match.end(),
                snippet=match.group(),
                category="vague-time",
                suggestion="Use specific dates or durations (e.g., 'within 5 business days')",
                severity="warning"
            ))
    return findings


def detect_absolutes(text: str) -> list[AmbiguityFinding]:
    """Detect unsupported absolute statements."""
    findings = []
    for i, line in enumerate(text.splitlines(), start=1):
        for match in ABSOLUTES.finditer(line):
            findings.append(AmbiguityFinding(
                file_path="<stdin>",
                line_number=i,
                column_start=match.start(),
                column_end=match.end(),
                snippet=match.group(),
                category="unsupported-absolute",
                suggestion="Add qualifying conditions or verify the absolute claim",
                severity="warning"
            ))
    return findings


def detect_vague_references(text: str) -> list[AmbiguityFinding]:
    """Detect vague demonstrative references."""
    findings = []
    for i, line in enumerate(text.splitlines(), start=1):
        for match in VAGUE_REFERENCE.finditer(line):
            findings.append(AmbiguityFinding(
                file_path="<stdin>",
                line_number=i,
                column_start=match.start(),
                column_end=match.end(),
                snippet=match.group(),
                category="vague-reference",
                suggestion="Specify exactly what is being referenced",
                severity="info"
            ))
    return findings


def detect_modal_ambiguity(text: str) -> list[AmbiguityFinding]:
    """Detect modal verbs that create requirement ambiguity."""
    findings = []
    for i, line in enumerate(text.splitlines(), start=1):
        for match in MODAL_AMBIGUITY.finditer(line):
            findings.append(AmbiguityFinding(
                file_path="<stdin>",
                line_number=i,
                column_start=match.start(),
                column_end=match.end(),
                snippet=match.group(),
                category="modal-ambiguity",
                suggestion="Clarify if this is required (must) or optional (may)",
                severity="error"  # Critical for technical specs
            ))
    return findings


def scan_file(path: Path) -> list[AmbiguityFinding]:
    """Scan a single file for ambiguities."""
    text = path.read_text(encoding="utf-8")
    
    findings: list[AmbiguityFinding] = []
    findings.extend(detect_passive_voice(text))
    findings.extend(detect_vague_quantifiers(text))
    findings.extend(detect_vague_time(text))
    findings.extend(detect_absolutes(text))
    findings.extend(detect_vague_references(text))
    findings.extend(detect_modal_ambiguity(text))
    
    # Attach file path to all findings
    for f in findings:
        f.file_path = str(path)
    
    return sorted(findings, key=lambda x: (x.line_number, x.column_start))


def scan_directory(root: Path, patterns: list[str] | None = None) -> list[AmbiguityFinding]:
    """Recursively scan a directory for ambiguities."""
    import fnmatch
    
    if patterns is None:
        patterns = ["*.md", "*.rst", "*.txt"]
    
    findings: list[AmbiguityFinding] = []
    
    for pattern in patterns:
        for path in root.glob("**/" + pattern):
            if not path.is_file():
                continue
            # Skip common exclusions
            if any(excluded in path.parts for excluded in ["node_modules", ".git", "vendor", "dist"]):
                continue
            findings.extend(scan_file(path))
    
    return findings


def generate_report(findings: list[AmbiguityFinding], output_format: str = "json") -> str:
    """Generate a formatted report."""
    import json
    
    if output_format == "json":
        return json.dumps([
            {
                "file": f.file_path,
                "line": f.line_number,
                "column_start": f.column_start,
                "column_end": f.column_end,
                "snippet": f.snippet,
                "category": f.category,
                "suggestion": f.suggestion,
                "severity": f.severity
            }
            for f in findings
        ], indent=2)
    
    elif output_format == "markdown":
        lines = ["# Ambiguity Report\n"]
        
        if not findings:
            lines.append("✓ No ambiguities detected.")
            return "\n".join(lines)
        
        lines.append(f"**Total findings:** {len(findings)}\n")
        
        # Group by severity
        by_severity = {}
        for f in findings:
            by_severity.setdefault(f.severity, []).append(f)
        
        for severity in ["error", "warning", "info"]:
            if severity not in by_severity:
                continue
            lines.append(f"## {severity.capitalize()} ({len(by_severity[severity])})\n")
            for f in by_severity[severity]:
                lines.append(f"- **{f.file_path}:{f.line_number}** — {f.category}")
                lines.append(f"  - Snippet: `{f.snippet}`")
                lines.append(f"  - Suggestion: {f.suggestion}")
                lines.append("")
        
        return "\n".join(lines)
    
    else:
        # Plain text
        lines = []
        for f in findings:
            lines.append(f"[{f.severity.upper()}] {f.file_path}:{f.line_number}")
            lines.append(f"  Category: {f.category}")
            lines.append(f"  Snippet: {f.snippet}")
            lines.append(f"  Suggestion: {f.suggestion}")
            lines.append("")
        return "\n".join(lines)


if __name__ == "__main__":
    import argparse
    
    parser = argparse.ArgumentParser(description="Detect ambiguities in documentation")
    parser.add_argument("paths", nargs="+", help="Files or directories to scan")
    parser.add_argument("--format", choices=["json", "markdown", "text"], default="json")
    parser.add_argument("--fail-on-error", action="store_true", help="Exit non-zero if errors found")
    
    args = parser.parse_args()
    
    findings: list[AmbiguityFinding] = []
    
    for path_str in args.paths:
        path = Path(path_str)
        if path.is_dir():
            findings.extend(scan_directory(path))
        elif path.is_file():
            findings.extend(scan_file(path))
        else:
            print(f"Path does not exist: {path}", file=__import__("sys").stderr)
            raise SystemExit(2)
    
    print(generate_report(findings, args.format))
    
    if args.fail_on_error and any(f.severity == "error" for f in findings):
        raise SystemExit(1)
