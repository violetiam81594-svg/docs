## How the author allowlist is built

The allowlist is generated, not hand-written. Four sources feed it, in order of authority.

### 1. Git blame and log identities

```python
#!/usr/bin/env python3
"""Generate a protected-terms dictionary from git authorship.

Usage:
    python scripts/gen_author_dict.py .github/author-names.txt
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

# Capitalised words of three or more characters, plus all-caps acronyms.
NAME_TOKEN = re.compile(r"[A-Z][a-z]{2,}|[A-Z]{2,}")


def git(*args: str) -> str:
    """Run a git command and return stdout, tolerating a non-zero exit."""
    result = subprocess.run(
        ["git", *args],
        capture_output=True,
        text=True,
        check=False,
    )
    return result.stdout


def tracked_files() -> list[str]:
    return [p for p in git("ls-files").splitlines() if p]


def collect_tokens() -> set[str]:
    tokens: set[str] = set()
    files = tracked_files()

    if files:
        porcelain = git("blame", "--line-porcelain", "--", *files)
        for line in porcelain.splitlines():
            if line.startswith(("author ", "committer ")):
                _, _, who = line.partition(" ")
                tokens.update(NAME_TOKEN.findall(who))

    # Trailers carry sign-off names that may not appear as an author.
    for key in ("Signed-off-by", "Co-authored-by"):
        trailer = git("log", f"--format=%(trailers:key={key},valueonly)")
        tokens.update(NAME_TOKEN.findall(trailer))

    return tokens


def main(argv: list[str]) -> int:
    out = Path(argv[1] if len(argv) > 1 else ".github/author-names.txt")
    words = sorted(collect_tokens(), key=str.lower)

    header = (
        "# GENERATED FILE - DO NOT EDIT BY HAND\n"
        "# Produced by scripts/gen_author_dict.py from git authorship.\n"
        f"# {len(words)} protected terms.\n"
    )
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(header + "\n".join(words) + "\n", encoding="utf-8")
    print(f"wrote {len(words)} protected terms to {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
```

### 2. `CODEOWNERS`

Parse the ownership file and extract every `@handle` and team slug. These are authorized parties by definition, so their names are protected even if they have never committed a line.

```python
def codeowners_terms(root: Path = Path(".")) -> set[str]:
    candidates = [
        root / "CODEOWNERS",
        root / ".github" / "CODEOWNERS",
        root / "docs" / "CODEOWNERS",
    ]
    terms: set[str] = set()
    for path in candidates:
        if not path.is_file():
            continue
        for raw in path.read_text(encoding="utf-8").splitlines():
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            for field in line.split()[1:]:  # field 0 is the path pattern
                terms.add(field.lstrip("@").replace("/", "-"))
    return terms
```

### 3. `.mailmap` canonical names

Every canonical name in `.mailmap` is protected, which prevents the checker from "correcting" a legal name that differs from a display handle.

### 4. An explicit project dictionary

Domain vocabulary that has nothing to do with authorship — product names, protocol terms, internal codenames — lives in a separate, hand-maintained file. Keeping it separate means regenerating the author list never clobbers curated words.

