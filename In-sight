name: Ambiguity Review and Spell Check

on:
  workflow_dispatch:
    inputs:
      blacme:
        description: 'Blame attribution mode'
        required: true
        default: 'auto'
        type: choice
        options:
          - auto
          - full
          - client-only
          - skip
      
      document_paths:
        description: 'Glob patterns for files'
        required: false
        default: '**/*.md'
        type: string
      
      spell_check_level:
        description: 'Spell check severity'
        required: false
        default: 'suggest'
        type: choice
        options:
          - off
          - report
          - suggest
          - enforce
      
      language_override:
        description: 'Locale override'
        required: false
        default: ''
        type: string
      
      strict_mode:
        description: 'Fail on any issue'
        required: false
        type: boolean
        default: false
      
      extract_device_detail:
        description: 'Extract device metadata'
        required: false
        type: boolean
        default: true
      
      check_identifiers:
        description: 'Check identifiers in code'
        required: false
        type: boolean
        default: false
      
      min_word_length:
        description: 'Minimum word length'
        required: false
        type: choice
        options:
          - '3'
          - '4'
          - '5'
          - '6'
        default: '4'
      
      regenerate_authors:
        description: 'Regenerate author dictionary'
        required: false
        type: boolean
        default: true
      
      output_format:
        description: 'Report format'
        required: false
        default: 'json'
        type: choice
        options:
          - json
          - markdown
          - sarif
  
  push:
    paths:
      - '**/*.md'
      - '.github/workflows/ambiguity-review.yml'

permissions:
  contents: read
  pull-requests: write

env:
  REPORT_DIR: reports/ambiguity

jobs:
  validate:
    name: Validate Inputs
    runs-on: ubuntu-latest
    outputs:
      valid: ${{ steps.validation.outputs.valid }}
      errors: ${{ steps.validation.outputs.errors }}
    steps:
      - uses: actions/checkout@v4
      
      - name: Validate workflow inputs
        id: validation
        run: |
          python scripts/validate_hook_inputs.py \
            --blacme "${{ inputs.blacme }}" \
            --paths "${{ inputs.document_paths }}" \
            --level "${{ inputs.spell_check_level }}" \
            --locale "${{ inputs.language_override }}" \
            --min-word-length "${{ inputs.min_word_length }}" \
            --json-output > validation-result.json
          
          echo "valid=$(jq -r '.valid' validation-result.json)" >> $GITHUB_OUTPUT
          echo "errors=$(jq -c '.errors' validation-result.json)" >> $GITHUB_OUTPUT
      
      - name: Upload validation report
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: validation-errors
          path: validation-result.json

  regenerate:
    name: Regenerate Author Dictionary
    runs-on: ubuntu-latest
    needs: validate
    if: |
      needs.validate.outputs.valid == 'true' &&
      inputs.regenerate_authors == 'true'
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      
      - name: Generate author dictionary
        run: |
          python scripts/gen_author_dict.py .github/author-names.txt
      
      - name: Upload author dictionary
        uses: actions/upload-artifact@v4
        with:
          name: author-names
          path: .github/author-names.txt
          retention-days: 7

  analyze:
    name: Ambiguity and Spell Analysis
    runs-on: ubuntu-latest
    needs: [validate, regenerate]
    if: needs.validate.outputs.valid == 'true'
    steps:
      - uses: actions/checkout@v4
      
      - name: Download author dictionary
        if: inputs.regenerate_authors == 'true'
        uses: actions/download-artifact@v4
        with:
          name: author-names
      
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
      
      - name: Install dependencies
        run: |
          npm install -g cspell typos
      
      - name: Run ambiguity detector
        run: |
          python scripts/ambiguity_detector.py \
            --pattern "${{ inputs.document_paths }}" \
            --format "${{ inputs.output_format }}" \
            --output "${{ env.REPORT_DIR }}/ambiguity.${{ inputs.output_format }}"
      
      - name: Run spell checker
        run: |
          cspell "${{ inputs.document_paths }}" \
            --config cspell.json \
            --no-progress \
            --relative \
            --output-file="${{ env.REPORT_DIR }}/spelling.json" \
            || true  # Don't fail the job
      
      - name: Extract device details
        if: inputs.extract_device_detail == 'true'
        run: |
          python scripts/extract_device_tokens.py \
            --paths "${{ inputs.document_paths }}" \
            --output "${{ env.REPORT_DIR }}/device-details.json"
      
      - name: Combine reports
        run: |
          python scripts/combine_reports.py \
            --ambiguity "${{ env.REPORT_DIR }}/ambiguity.${{ inputs.output_format }}" \
            --spelling "${{ env.REPORT_DIR }}/spelling.json" \
            --device "${{ env.REPORT_DIR }}/device-details.json" \
            --output "${{ env.REPORT_DIR }}/combined.${{ inputs.output_format }}"
      
      - name: Upload combined report
        uses: actions/upload-artifact@v4
        with:
          name: review-report
          path: ${{ env.REPORT_DIR }}/**
          retention-days: 7

  comment:
    name: Post Review Comment
    runs-on: ubuntu-latest
    needs: [validate, analyze]
    if: |
      needs.validate.outputs.valid == 'true' &&
      github.event_name == 'pull_request'
    steps:
      - uses: actions/checkout@v4
      
      - name: Download report
        uses: actions/download-artifact@v4
        with:
          name: review-report
          path: reports
      
      - name: Post PR comment
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const report = fs.readFileSync('reports/combined.markdown', 'utf8');
            
            const summary = {
              title: '📝 Ambiguity and Spell Review',
              findings: {
                ambiguities: 0,
                spell_errors: 0,
                device_details: 0
              }
            };
            
            // Parse report for counts
            const ambMatch = report.match(/Total findings: (\d+)/);
            if (ambMatch) summary.findings.ambiguities = parseInt(ambMatch[1]);
            
            const spellMatch = report.match(/spell errors: (\d+)/);
            if (spellMatch) summary.findings.spell_errors = parseInt(spellMatch[1]);
            
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
              body: report
            });
            
            console.log(`Posted review comment for PR #${context.issue.number}`);

  fail-if-strict:
    name: Enforce Strict Mode
    runs-on: ubuntu-latest
    needs: analyze
    if: |
      inputs.strict_mode == 'true' &&
      needs.analyze.result != 'success'
    steps:
      - name: Fail workflow
        run: |
          echo "::error::Strict mode enabled: workflow fails on any detected issue"
          exit 1
