Input Payload Validation
Validation Script
Every workflow begins with input validation to reject malformed or malicious payloads.

#!/usr/bin/env python3
"""
Validate workflow_dispatch input payloads for the ambiguity review hook.

Usage:
    python scripts/validate_hook_inputs.py \
        --blacme "auto" \
        --paths "**/*.md" \
        --level "suggest"
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import Any


VALID_BLACME_MODES = frozenset({"auto", "full", "client-only", "skip"})
VALID_SPELL_LEVELS = frozenset({"off", "report", "suggest", "enforce"})
VALID_OUTPUT_FORMATS = frozenset({"json", "markdown", "sarif"})
MIN_WORD_LENGTHS = frozenset({"3", "4", "5", "6"})

# Safe glob patterns — reject shell metacharacters
SAFE_GLOB_PATTERN = re.compile(r"^[\w./\*\[\]{}!@]+$")


def validate_blacme(mode: str) -> tuple[bool, str]:
    """Validate blame attribution mode."""
    if mode not in VALID_BLACME_MODES:
        return False, f"Invalid blacme mode: {mode}. Choose from {sorted(VALID_BLACME_MODES)}"
    return True, ""


def validate_glob_pattern(pattern: str) -> tuple[bool, str]:
    """Validate glob pattern for security."""
    if not pattern:
        return True, ""  # Empty is valid (means "all")
    
    # Reject shell injection patterns
    dangerous = [";", "$(", "`", "|", "&", "\n", "\r"]
    if any(d in pattern for d in dangerous):
        return False, "Glob pattern contains dangerous characters"
    
    if not SAFE_GLOB_PATTERN.match(pattern):
        return False, f"Glob pattern is malformed: {pattern}"
    
    return True, ""


def validate_spell_level(level: str) -> tuple[bool, str]:
    """Validate spell check severity level."""
    if level not in VALID_SPELL_LEVELS:
        return False, f"Invalid spell_check_level: {level}"
    return True, ""


def validate_locale(locale: str) -> tuple[bool, str]:
    """Validate locale code (e.g., en-US, de-DE)."""
    if not locale:
        return True, ""
    
    # BCP 47 pattern
    pattern = re.compile(r"^[a-z]{2}(-[A-Z][a-z]{2})?(-[A-Z]{2}|-\d{3})?$", re.IGNORECASE)
    if not pattern.match(locale):
        return False, f"Invalid locale format: {locale}. Use BCP 47 (e.g., en-US)"
    
    return True, ""


def validate_output_format(fmt: str) -> tuple[bool, str]:
    """Validate output format."""
    if fmt not in VALID_OUTPUT_FORMATS:
        return False, f"Invalid output_format: {fmt}"
    return True, ""


def validate_min_word_length(length: str) -> tuple[bool, str]:
    """Validate minimum word length threshold."""
    if length not in MIN_WORD_LENGTHS:
        return False, f"Invalid min_word_length: {length}"
    return True, ""


def validate_boolean(value: Any) -> tuple[bool, str]:
    """Validate boolean input."""
    if isinstance(value, bool):
        return True, ""
    if isinstance(value, str) and value.lower() in {"true", "false"}:
        return True, ""
    return False, f"Boolean expected, got: {value}"


def run_validation(inputs: dict[str, Any]) -> dict[str, Any]:
    """Run all validations and return results."""
    errors: list[dict[str, str]] = []
    warnings: list[dict[str, str]] = []
    
    # blacme (required)
    valid, msg = validate_blacme(inputs.get("blacme", ""))
    if not valid:
        errors.append({"field": "blacme", "message": msg})
    
    # document_paths
    valid, msg = validate_glob_pattern(inputs.get("document_paths", ""))
    if not valid:
        errors.append({"field": "document_paths", "message": msg})
    elif len(inputs.get("document_paths", "")) > 256:
        warnings.append({"field": "document_paths", "message": "Pattern exceeds 256 characters"})
    
    # spell_check_level
    valid, msg = validate_spell_level(inputs.get("spell_check_level", ""))
    if not valid:
        errors.append({"field": "spell_check_level", "message": msg})
    
    # language_override
    valid, msg = validate_locale(inputs.get("language_override", ""))
    if not valid:
        errors.append({"field": "language_override", "message": msg})
    
    # strict_mode
    valid, msg = validate_boolean(inputs.get("strict_mode", False))
    if not valid:
        errors.append({"field": "strict_mode", "message": msg})
    
    # extract_device_detail
    valid, msg = validate_boolean(inputs.get("extract_device_detail", True))
    if not valid:
        errors.append({"field": "extract_device_detail", "message": msg})
    
    # check_identifiers
    valid, msg = validate_boolean(inputs.get("check_identifiers", False))
    if not valid:
        errors.append({"field": "check_identifiers", "message": msg})
    
    # min_word_length
    valid, msg = validate_min_word_length(inputs.get("min_word_length", "4"))
    if not valid:
        errors.append({"field": "min_word_length", "message": msg})
    
    # regenerate_authors
    valid, msg = validate_boolean(inputs.get("regenerate_authors", True))
    if not valid:
        errors.append({"field": "regenerate_authors", "message": msg})
    
    # output_format
    valid, msg = validate_output_format(inputs.get("output_format", "json"))
    if not valid:
        errors.append({"field": "output_format", "message": msg})
    
    return {
        "valid": len(errors) == 0,
        "errors": errors,
        "warnings": warnings,
        "validated_inputs": {k: v for k, v in inputs.items() if k in [
            "blacme", "document_paths", "spell_check_level", "language_override",
            "strict_mode", "extract_device_detail", "check_identifiers",
            "min_word_length", "regenerate_authors", "output_format"
        ]}
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Validate ambiguity review hook inputs")
    parser.add_argument("--blacme", required=True)
    parser.add_argument("--paths", dest="document_paths", default="", help="File glob patterns")
    parser.add_argument("--level", dest="spell_check_level", default="suggest")
    parser.add_argument("--locale", dest="language_override", default="")
    parser.add_argument("--strict-mode", dest="strict_mode", action="store_true", default=False)
    parser.add_argument("--no-device-detail", dest="extract_device_detail", action="store_false", default=True)
    parser.add_argument("--check-identifiers", dest="check_identifiers", action="store_true", default=False)
    parser.add_argument("--min-word-length", dest="min_word_length", default="4")
    parser.add_argument("--no-regenerate-authors", dest="regenerate_authors", action="store_false", default=True)
    parser.add_argument("--output-format", dest="output_format", default="json")
    parser.add_argument("--json-output", action="store_true", help="Output JSON instead of exit codes")
    
    args = parser.parse_args(argv)
    
    inputs = {
        "blacme": args.blacme,
        "document_paths": args.document_paths,
        "spell_check_level": args.spell_check_level,
        "language_override": args.language_override,
        "strict_mode": args.strict_mode,
        "extract_device_detail": args.extract_device_detail,
        "check_identifiers": args.check_identifiers,
        "min_word_length": args.min_word_length,
        "regenerate_authors": args.regenerate_authors,
        "output_format": args.output_format,
    }
    
    result = run_validation(inputs)
    
    if args.json_output:
        print(json.dumps(result, indent=2))
    else:
        if result["valid"]:
            print("✓ All inputs validated successfully")
            if result["warnings"]:
                print("\nWarnings:")
                for w in result["warnings"]:
                    print(f"  ⚠ {w['field']}: {w['message']}")
            return 0
        else:
            print("✗ Input validation failed:")
            for e in result["errors"]:
                print(f"  ✗ {e['field']}: {e['message']}")
            return 1


if __name__ == "__main__":
    raise SystemExit(main())
